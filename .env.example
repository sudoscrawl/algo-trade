# ── Exchange credentials ──────────────────────────────────────────────────────
# Binance API key and secret. Required when PAPER_TRADE=false.
API_KEY=your_binance_api_key_here
API_SECRET=your_binance_api_secret_here

# ── Exchange URLs ─────────────────────────────────────────────────────────────
# Mainnet (default). Swap to testnet URLs for safe testing:
#   REST:  https://testnet.binance.vision
#   WS:    wss://testnet.binance.vision/stream?streams=
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream?streams=

# HTTP request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=10.0

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg connection URL. Plain postgresql:// is also accepted (driver rewritten automatically).
DB_URL=postgresql+asyncpg://algo_trade:algo_trade@localhost:5432/algo_trade

# ── Execution mode ────────────────────────────────────────────────────────────
# PAPER_TRADE=true  → simulated fills, no real orders placed (safe default)
# PAPER_TRADE=false → live Binance orders (requires API_KEY + API_SECRET + LIVE_TRADING_ENABLED=true)
PAPER_TRADE=true

# Safety interlock: must be explicitly set to true before live execution is allowed.
LIVE_TRADING_ENABLED=false

# Simulated starting balance for paper trading (USDT).
PAPER_TRADE_BALANCE=10000.0

# Simulated slippage applied to paper-trade fill prices (basis points, per side).
# 5 bps = 0.05% — buys fill slightly above mid, sells slightly below.
SLIPPAGE_BPS=5.0

# ── Symbols ───────────────────────────────────────────────────────────────────
# Comma-separated list of Binance spot symbols to track and trade.
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT

# Maximum number of simultaneously open long positions.
MAX_OPEN_POSITIONS=5

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Snapshot + strategy evaluation cadence in seconds.
TICK_PERIOD=60

# ── Strategy — EMA ───────────────────────────────────────────────────────────
FAST_EMA_PERIOD=8
SLOW_EMA_PERIOD=21

# ── Strategy — RSI ───────────────────────────────────────────────────────────
RSI_PERIOD=14
RSI_BUY_MIN=20.0
RSI_BUY_MAX=75.0
RSI_SELL_THRESHOLD=45.0
RSI_SELL_MIN=25.0

# ── Strategy — Bollinger Bands ────────────────────────────────────────────────
BB_PERIOD=20
BB_STD=2.0

# ── Strategy — ATR ───────────────────────────────────────────────────────────
ATR_PERIOD=14

# ── Strategy — Rate of Change ─────────────────────────────────────────────────
ROC_PERIOD=10
ROC_BUY_THRESHOLD=0.1

# ── Strategy — Entry / exit thresholds ───────────────────────────────────────
MIN_HISTORY=50
EMA_SEPARATION_PCT=0.005
CONFIRM_TICKS=1
MIN_HOLD_CYCLES=3
MIN_PROFIT_PCT=0.15
STOP_LOSS_PCT=2.5
TAKE_PROFIT_PCT=4.0
STAGNANT_EXIT_CYCLES=20
TRAILING_ACTIVATE_PCT=1.5
TRAILING_STOP_PCT=1.0
LOSS_COOLDOWN_CYCLES=3

# ── Risk / sizing ─────────────────────────────────────────────────────────────
MAX_POSITION_PCT=0.18
BASE_POSITION_PCT=0.055
MIN_ORDER_USDT=10.0
MAX_DRAWDOWN_PCT=0.15
COMMISSION_RATE=0.001
RESERVE_PCT=0.03

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=logs/algo-trade.log
